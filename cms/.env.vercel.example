# Import these values into the CMS Vercel project, Production environment.
# Generate private secrets with: npm run cms:vercel:setup -- --public-url https://your-cms.vercel.app
CMS_DEPLOYMENT_TARGET=vercel
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://cms-eight-puce-83.vercel.app
TRUST_PROXY=true
STRAPI_TELEMETRY_DISABLED=true

APP_KEYS=REPLACE_WITH_TWO_DISTINCT_RANDOM_KEYS_SEPARATED_BY_COMMA
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
API_TOKEN_SALT=REPLACE_WITH_RANDOM_SECRET
TRANSFER_TOKEN_SALT=REPLACE_WITH_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Use a dedicated Neon database. Copy the PostgreSQL URL supplied by its integration.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# Connect a PUBLIC Vercel Blob store to the CMS project.
# Vercel provides BLOB_STORE_ID and VERCEL_OIDC_TOKEN for SDK authentication.
# Leave the optional read-write token empty when using OIDC.
UPLOAD_PROVIDER=vercel-blob
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_PATH_PREFIX=strapi/production
