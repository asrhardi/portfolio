{
  "name": "new-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-writing.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:cms": "npm --prefix cms run test:writing",
    "cms:setup": "npm --prefix cms run setup",
    "cms:docker:setup": "node cms/scripts/setup-docker-env.cjs",
    "cms:up": "npm --prefix cms run docker:up",
    "cms:down": "npm --prefix cms run docker:down",
    "cms:logs": "npm --prefix cms run docker:logs",
    "cms:status": "npm --prefix cms run docker:status",
    "cms:dev": "npm --prefix cms run setup && npm --prefix cms run develop -- --no-watch-admin",
    "cms:build": "npm --prefix cms run build",
    "cms:start": "npm --prefix cms run start"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/vite": "^4.1.13",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
